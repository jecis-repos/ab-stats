{
    "name": "jekabs/ab-stats",
    "description": "Zero-dependency PHP A/B testing statistics — chi-squared test with Yates' correction, Wilson-Hilferty CDF approximation, and auto-winner detection.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jekabs Porietis",
            "email": "jekabsporietis@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Jekabs\\AbStats\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jekabs\\AbStats\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "keywords": ["ab-testing", "statistics", "chi-squared", "hypothesis-testing", "conversion-rate"]
}
